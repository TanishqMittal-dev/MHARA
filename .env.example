# MHARA Real Estate - Environment Configuration Template
# Copy this file to .env and use your existing MongoDB Atlas URI.
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.biusp7i.mongodb.net/MHARA_RealEstate?retryWrites=true&w=majority
# Set a random value of 32+ characters for persistent signed sessions.
SESSION_SECRET=replace-with-a-long-random-secret
